-- ============================================
-- RPC: consume_invite (原子消耗邀请码词元)
-- ============================================
CREATE OR REPLACE FUNCTION consume_invite(p_token TEXT, p_usage INT)
RETURNS BOOLEAN
LANGUAGE plpgsql SECURITY DEFINER AS $$
DECLARE
  v_used INT;
  v_quota INT;
BEGIN
  SELECT token_used, token_quota INTO v_used, v_quota
  FROM invite_codes WHERE token = p_token AND expires_at > NOW();
  IF NOT FOUND THEN RETURN FALSE; END IF;
  IF v_used + p_usage > v_quota THEN RETURN FALSE; END IF;
  UPDATE invite_codes SET token_used = v_used + p_usage WHERE token = p_token;
  RETURN TRUE;
END;
$$;
