-- Migration: initial schema (idempotent)

-- ============================================
-- Tables
-- ============================================

CREATE TABLE IF NOT EXISTS chat_messages (
  id SERIAL PRIMARY KEY,
  user_id UUID REFERENCES auth.users,
  role TEXT NOT NULL DEFAULT 'user',
  content TEXT NOT NULL,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS invite_codes (
  id          SERIAL PRIMARY KEY,
  token       TEXT UNIQUE NOT NULL,
  description TEXT DEFAULT '',
  token_quota INT NOT NULL DEFAULT 5000,
  token_used  INT NOT NULL DEFAULT 0,
  expires_at  TIMESTAMPTZ NOT NULL,
  created_by  TEXT,
  created_at  TIMESTAMPTZ DEFAULT NOW()
);

-- ============================================
-- Site Categories
-- ============================================
CREATE TABLE IF NOT EXISTS site_categories (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  slug TEXT NOT NULL UNIQUE,
  sort_order INT DEFAULT 0,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- ============================================
-- Site Tags
-- ============================================
CREATE TABLE IF NOT EXISTS site_tags (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  slug TEXT NOT NULL UNIQUE,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- ============================================
-- Site Posts
-- ============================================
CREATE TABLE IF NOT EXISTS site_posts (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  detail TEXT NOT NULL,
  category_id INTEGER REFERENCES site_categories(id) ON DELETE SET NULL,
  document_id INTEGER,
  sort_order INT DEFAULT 0,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- ============================================
-- Post-Tags junction table (N:M)
-- ============================================
CREATE TABLE IF NOT EXISTS site_post_tags (
  post_id INTEGER NOT NULL REFERENCES site_posts(id) ON DELETE CASCADE,
  tag_id INTEGER NOT NULL REFERENCES site_tags(id) ON DELETE CASCADE,
  PRIMARY KEY (post_id, tag_id)
);

-- ============================================
-- RAG / Vector Search
-- ============================================
CREATE EXTENSION IF NOT EXISTS vector;

CREATE TABLE IF NOT EXISTS rag_documents (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  content TEXT NOT NULL,
  source TEXT DEFAULT '',
  embedding VECTOR(1024),
  created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE OR REPLACE FUNCTION search_rag_docs(
  query_embedding VECTOR(1536),
  match_threshold FLOAT DEFAULT 0.7,
  match_count INT DEFAULT 5
) RETURNS TABLE(
  id INT,
  title TEXT,
  content TEXT,
  similarity FLOAT
) LANGUAGE SQL STABLE AS $$
  SELECT
    id,
    title,
    content,
    1 - (embedding <=> query_embedding) AS similarity
  FROM rag_documents
  WHERE 1 - (embedding <=> query_embedding) > match_threshold
  ORDER BY similarity DESC
  LIMIT match_count;
$$;

-- ============================================
-- RLS: enable on all tables
-- ============================================
DO $$
BEGIN
  ALTER TABLE IF EXISTS invite_codes ENABLE ROW LEVEL SECURITY;
  ALTER TABLE IF EXISTS site_categories ENABLE ROW LEVEL SECURITY;
  ALTER TABLE IF EXISTS site_tags ENABLE ROW LEVEL SECURITY;
  ALTER TABLE IF EXISTS site_posts ENABLE ROW LEVEL SECURITY;
  ALTER TABLE IF EXISTS site_post_tags ENABLE ROW LEVEL SECURITY;
  ALTER TABLE IF EXISTS rag_documents ENABLE ROW LEVEL SECURITY;
  ALTER TABLE IF EXISTS chat_messages ENABLE ROW LEVEL SECURITY;
END $$;

