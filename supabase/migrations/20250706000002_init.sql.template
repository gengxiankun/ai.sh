  IF NOT EXISTS (SELECT 1 FROM pg_policies WHERE policyname = 'public_read' AND tablename = 'site_tags') THEN
    CREATE POLICY "public_read" ON site_tags FOR SELECT USING (true);
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_policies WHERE policyname = 'public_read' AND tablename = 'site_posts') THEN
    CREATE POLICY "public_read" ON site_posts FOR SELECT USING (true);
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_policies WHERE policyname = 'public_read' AND tablename = 'site_post_tags') THEN
    CREATE POLICY "public_read" ON site_post_tags FOR SELECT USING (true);
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_policies WHERE policyname = 'public_read' AND tablename = 'rag_documents') THEN
    CREATE POLICY "public_read" ON rag_documents FOR SELECT USING (true);
  END IF;
END $$;

