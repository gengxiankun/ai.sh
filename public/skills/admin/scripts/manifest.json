{
  "list_posts": { "file": "list_posts.js", "description": "列出所有文章" },
  "create_post": { "file": "create_post.js", "description": "新增文章（需先 list_categories/list_tags）", "params": { "title": "标题", "detail": "内容(Markdown)", "category_id": "分类id", "tags": "标签id数组" } },
  "update_post": { "file": "update_post.js", "description": "编辑文章", "params": { "id": "文章id", "title": "新标题(可选)", "detail": "新内容(可选)", "category_id": "分类id(可选)", "tags": "标签id数组(可选)" } },
  "delete_post": { "file": "delete_post.js", "description": "按 id 删除文章", "params": { "id": "文章id" } },

  "list_categories": { "file": "list_categories.js", "description": "列出所有分类" },
  "create_category": { "file": "create_category.js", "description": "新增分类", "params": { "name": "分类名" } },
  "update_category": { "file": "update_category.js", "description": "编辑分类", "params": { "id": "分类id", "name": "新分类名(可选)" } },
  "delete_category": { "file": "delete_category.js", "description": "按 id 删除分类", "params": { "id": "分类id" } },

  "list_tags": { "file": "list_tags.js", "description": "列出所有标签" },
  "create_tag": { "file": "create_tag.js", "description": "新增标签", "params": { "name": "标签名" } },
  "update_tag": { "file": "update_tag.js", "description": "编辑标签", "params": { "id": "标签id", "name": "新标签名(可选)" } },
  "delete_tag": { "file": "delete_tag.js", "description": "按 id 删除标签", "params": { "id": "标签id" } },

  "update_about": { "file": "update_about.js", "description": "更新关于内容", "params": { "content": "关于内容(Markdown)" } },

  "list_kb": { "file": "list_kb.js", "description": "列出知识库文档" },
  "create_kb": { "file": "create_kb.js", "description": "新增知识库文档(自动生成 embedding)", "params": { "title": "标题", "content": "内容", "source": "来源标记(可选)" } },
  "delete_kb": { "file": "delete_kb.js", "description": "按 id 删除知识库文档", "params": { "id": "文档 id" } }
}
